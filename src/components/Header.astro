---
interface Props {
	home?: boolean;
}

const { home = false } = Astro.props;
---

<header class:list={['header', { 'is-home': home }]} data-header>
	<div class="wrap bar">
		<a
			href="/"
			class="brand"
			aria-label="Darío Ceballos, ir a la portada"
			transition:name={home ? undefined : 'nombre'}
		>
			Dar<span class="i-tilde">í</span>o Ceballos
		</a>
		<nav class="nav" aria-label="Principal">
			<a href="/#proyectos">Proyectos</a>
			<a href="#contacto">Contacto</a>
			<button class="theme" type="button" aria-label="Cambiar tema" data-theme-toggle>
				<svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
				</svg>
				<svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	function setup() {
		const header = document.querySelector<HTMLElement>('[data-header]');
		if (!header) return;

		// En la portada, el nombre de la barra aparece cuando el título sale de la pantalla.
		const hero = document.querySelector('[data-hero-name]');
		if (header.classList.contains('is-home') && hero) {
			const observer = new IntersectionObserver(
				([entry]) => header.classList.toggle('show-brand', !entry.isIntersecting),
				{ rootMargin: '-64px 0px 0px 0px' },
			);
			observer.observe(hero);
			document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
		}

		const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
		document.addEventListener(
			'astro:before-swap',
			() => window.removeEventListener('scroll', onScroll),
			{ once: true },
		);

		header.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem('theme', next);
			} catch {}
		});
	}

	document.addEventListener('astro:page-load', setup);
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--bg);
		border-bottom: 1px solid transparent;
		transition: border-color 200ms ease, background-color 200ms ease;
	}

	.header.scrolled {
		border-bottom-color: var(--line);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	.brand {
		font-family: var(--font-logo);
		font-size: 26px;
		line-height: 1;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
	}

	@media (max-width: 640px) {
		.brand {
			font-size: 20px;
		}
	}

	.is-home .brand {
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out);
	}

	.is-home.show-brand .brand {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: var(--s-3);
		font-size: 14px;
	}

	@media (max-width: 640px) {
		.nav {
			gap: var(--s-2);
		}
	}

	.nav a {
		color: var(--body);
		text-decoration: none;
		transition: color 150ms ease;
	}

	.nav a:hover {
		color: var(--text);
	}

	.theme {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		margin-right: -6px;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--body);
		cursor: pointer;
		transition: color 150ms ease, background-color 150ms ease;
	}

	.theme:hover {
		color: var(--text);
		background: var(--chip);
	}

	.icon {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Se muestra el icono del tema al que se cambiaría. */
	.sun {
		display: none;
	}

	:global([data-theme='dark']) .sun {
		display: block;
	}

	:global([data-theme='dark']) .moon {
		display: none;
	}
</style>
