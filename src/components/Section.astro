---
interface Props {
	label?: string;
	id?: string;
}

const { label, id } = Astro.props;
---

<section class="section aparece" id={id}>
	<h2 class="label mono">{label}</h2>
	<div class="content">
		<slot />
	</div>
</section>

<style>
	/* Etiqueta al margen izquierdo, texto a medida de lectura y margen derecho para
	   figuras; en el móvil, todo en una columna con la etiqueta encima. */
	.section {
		display: grid;
		grid-template-columns: var(--label) minmax(0, var(--measure)) var(--aside);
		gap: 0 var(--gutter);
	}

	.label {
		font-size: 12px;
		font-weight: 400;
		line-height: 1.7;
		color: var(--muted);
		padding-top: 3px;
	}

	.content {
		max-width: var(--measure);
	}

	@media (max-width: 640px) {
		.section {
			grid-template-columns: minmax(0, 1fr);
		}

		.label {
			padding: 0;
			margin-bottom: var(--s-2);
		}
	}
</style>
